# IBVAP Environment Variables

# Backend Server Configuration
IBVAP_HOST=0.0.0.0
IBVAP_PORT=8000
IBVAP_MODE=demo
IBVAP_SECRET_KEY=ibvap-secret-key-surveillance-2026

# Database (Default SQLite for local demo, postgresql for production)
DATABASE_URL=sqlite:///data/ibvap.db

# CCTV & RTSP Credentials
RTSP_USERNAME=admin
RTSP_PASSWORD=secure_cctv_password
RTSP_DEFAULT_STREAM=rtsp://admin:secure_cctv_password@192.168.1.100:554/live

# Device Preference: auto, cuda, or cpu
DEVICE=auto
